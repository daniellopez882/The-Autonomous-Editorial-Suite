# Keep the build context to what the image needs. Without this file the
# context included .git, local virtualenvs, caches and -- if a developer had
# one -- the .env holding real keys, which COPY . . would have baked into a layer.
.git
.gitignore
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.coverage
htmlcov
.env
.env.*
!.env.example
*.log
generation_log.txt
generated_content/
tests/
docs/
scripts/
*.md
!README.md
Dockerfile
docker-compose.yml
.dockerignore
