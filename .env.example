# Copy to .env and fill in. Never commit the result.
#
# The previous version of this file shipped APP_PASSWORD=admin and a placeholder
# APP_SECRET_KEY as the values to copy, and a SERPER_API_KEY nothing reads.

# ---- Model ------------------------------------------------------------------
# Needed to generate. The app starts without it, serves its login page, and
# refuses each generation with a sentence naming this variable.
DEEPSEEK_API_KEY=
# Any OpenAI-compatible endpoint works; these are the defaults.
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Login gate ---------------------------------------------------------------
# development | production. The container image sets production, where the
# preflight refuses a missing APP_SECRET_KEY or a well-known APP_PASSWORD.
ENVIRONMENT=development

# Signs the session cookie. Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In development, leave it empty to get a random per-process key.
APP_SECRET_KEY=

# Required in production; admin / password / changeme / empty are refused.
# In development the gate accepts admin / admin.
APP_USERNAME=admin
APP_PASSWORD=

# false switches the gate off for local development only; refused in production.
ENABLE_AUTH=true
